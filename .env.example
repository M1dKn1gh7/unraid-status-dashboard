# Server Status Dashboard - Environment Variables
# Copy to .env and fill in your values

# Dashboard
DASHBOARD_PORT=9090

# Glances (system metrics)
GLANCES_URL=http://192.168.1.200:61208

# Tautulli (Plex monitoring)
TAUTULLI_URL=http://192.168.1.200:8181
TAUTULLI_API_KEY=your_tautulli_api_key

# qBittorrent (downloads)
QBIT_URL=http://192.168.1.200:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=your_qbit_password

# Overseerr (media requests)
OVERSEERR_URL=http://192.168.1.200:5055
OVERSEERR_API_KEY=your_overseerr_api_key

# Home Assistant (UPS data via NUT integration)
HA_URL=http://192.168.1.200:8123
HA_TOKEN=your_long_lived_access_token

# UniFi (network stats)
UNIFI_URL=https://192.168.1.1
UNIFI_USERNAME=your_unifi_admin
UNIFI_PASSWORD=your_unifi_password
UNIFI_SITE=default

# Unraid GraphQL API (optional - array/docker state)
# Requires Unraid 6.12+. Generate API key in:
# Unraid WebUI > Settings > Management Access > API Keys
UNRAID_API_URL=https://192.168.1.200/graphql
UNRAID_API_KEY=your_unraid_api_key

# Unraid emhttp directory (live parity check status)
# Mount the DIRECTORY, not the file: -v /var/local/emhttp:/host/emhttp:ro
UNRAID_VAR_INI=/host/emhttp

# Cache TTLs (seconds)
CACHE_TTL_SYSTEM=10
CACHE_TTL_MEDIA=15
CACHE_TTL_UPS=10
CACHE_TTL_NETWORK=30
CACHE_TTL_UNRAID=30
